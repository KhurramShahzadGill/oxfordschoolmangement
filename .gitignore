# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Environment variables (Supabase keys etc.) — never commit
.env
.env.*
!.env.example

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Database backups hold real student and parent data. Never commit: this repo is
# pushed to GitHub and deployed publicly, so a dump here would leak the school's
# records to anyone who can read the repo or the built site.
backups/*
!backups/README.md
*.backup
*.backup.gz
*.dump
*.sql.gz
